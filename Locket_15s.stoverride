name: "Locket 15s VIP"
desc: "Mở khóa Locket Gold, video 15s camera và thư viện, 280 caption & hình ảnh chất lượng HD"
author: "Nguyen Tien Thuong"

http:
  mitm:
    - "api.revenuecat.com"
    - "api.rc-backup.com"
    - "firebaseremoteconfig.googleapis.com"

  script:
    - match: ^https:\/\/api\.(revenuecat|rc-backup)\.com(?::443)?\/.+\/(receipts|subscribers)
      name: locket_del_header
      type: request
      require-body: false
      timeout: 60
      script-path: https://raw.githubusercontent.com/Thuong404-lab/Locket_15s_Full_Source/main/del_header.js?v=20

    - match: ^https:\/\/api\.(revenuecat|rc-backup)\.com(?::443)?\/.+\/(receipts(?:\?.*)?$|subscribers\/[^/?]+\/?(?:\?.*)?$)
      name: locket_revenuecat
      type: response
      require-body: true
      timeout: 60
      script-path: https://raw.githubusercontent.com/Thuong404-lab/Locket_15s_Full_Source/main/Locket.js?v=20

    - match: ^https:\/\/firebaseremoteconfig\.googleapis\.com(?::443)?\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch
      name: locket_rc_us
      type: request
      require-body: true
      timeout: 10
      script-path: https://raw.githubusercontent.com/Thuong404-lab/Locket_15s_Full_Source/main/Locket_rc_us.js?v=20

    - match: ^https:\/\/firebaseremoteconfig\.googleapis\.com(?::443)?\/v1\/projects\/locket-4252a\/.+
      name: locket_rc
      type: response
      require-body: true
      timeout: 60
      script-path: https://raw.githubusercontent.com/Thuong404-lab/Locket_15s_Full_Source/main/Locket_Unlocked_Clean.js?v=20
